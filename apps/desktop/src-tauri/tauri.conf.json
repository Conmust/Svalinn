{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Svalinn",
  "version": "0.1.0",
  "identifier": "app.svalinn.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Svalinn",
        "width": 1100,
        "height": 720,
        "minWidth": 760,
        "minHeight": 480,
        "fullscreen": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
