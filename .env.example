# Copy to .env and fill in. Never commit real credentials.

# Database (matches docker-compose.yml)
DATABASE_URL=postgres://svalinn:svalinn_dev@localhost:5432/svalinn

# Secret used to sign login tokens. Use a long random value outside development.
JWT_SECRET=change-me

# Keeps email addresses out of plaintext storage (see email_privacy.rs).
# EMAIL_ENCRYPTION_KEY: a base64-encoded 32-byte AES-256 key. Generate with:
#   openssl rand -base64 32
# Losing this makes every stored email permanently unrecoverable -- back it up.
EMAIL_ENCRYPTION_KEY=change-me-run-openssl-rand--base64-32
# EMAIL_BLIND_INDEX_PEPPER: a long random secret used to look up emails
# (login, uniqueness, ban checks) without ever storing them in a searchable
# plaintext form. Generate with:
#   openssl rand -hex 32
# Unlike the key above, losing data isn't the risk here -- but changing this
# value once chosen makes every existing account's email unmatchable against
# new input (effectively locking everyone out by email lookup), so treat it
# as permanent once set.
EMAIL_BLIND_INDEX_PEPPER=change-me-run-openssl-rand-hex-32

# Sends verification and password-reset emails through Resend
# (https://resend.com). Required outside development; in development,
# unset is fine -- those links are returned directly in the API response
# instead (dev_verification_link / dev_reset_link), so no real inbox is
# needed. Create a key at https://resend.com/api-keys, and set EMAIL_FROM
# to a sender address you've verified a domain for with Resend.
# RESEND_API_KEY=re_change_me
# EMAIL_FROM=Svalinn <noreply@yourdomain.com>

# Redis
REDIS_URL=redis://localhost:6379

# Application
APP_ENV=development
RUST_LOG=info

# Where the server listens. Use HOST=0.0.0.0 to accept connections from other
# machines (put it behind a reverse proxy with HTTPS before going public).
HOST=127.0.0.1
PORT=3001

# Origins allowed to call the API from a browser or the desktop app,
# comma-separated. Leave unset for the defaults: the dev server
# (http://localhost:1420) and the Tauri app (tauri://localhost,
# https://tauri.localhost). Add your own if you host a web build.
# CORS_ALLOWED_ORIGINS=http://localhost:1420,tauri://localhost,https://tauri.localhost

# Set to true only when running behind a reverse proxy, so rate limits use the
# client address the proxy reports (X-Forwarded-For) instead of the proxy's.
# TRUST_PROXY=true

# Voice/video calls: must match the coturn container's TURN_SECRET in
# docker-compose.yml. Used to mint short-lived TURN credentials (REST API
# time-limited shared-secret scheme), never sent to clients directly.
# Use a long random value outside development.
TURN_SECRET=change-me-turn-secret
TURN_REALM=svalinn.local

# Host:port (or comma-separated list) clients should reach the TURN server
# at. In development this is usually the same machine as the API server;
# set it to your real hostname/IP once coturn is reachable from outside
# localhost (e.g. behind a reverse proxy or on its own public IP).
TURN_URIS=turn:localhost:3478
