# Copy to .env and fill in. Never commit real credentials.

# Database (matches docker-compose.yml)
DATABASE_URL=postgres://svalinn:svalinn_dev@localhost:5432/svalinn

# Secret used to sign login tokens. Use a long random value outside development.
JWT_SECRET=change-me

# Redis
REDIS_URL=redis://localhost:6379

# Application
APP_ENV=development
RUST_LOG=info

# Where the server listens. Use HOST=0.0.0.0 to accept connections from other
# machines (put it behind a reverse proxy with HTTPS before going public).
HOST=127.0.0.1
PORT=3001

# Origins allowed to call the API from a browser or the desktop app,
# comma-separated. Leave unset for the defaults: the dev server
# (http://localhost:1420) and the Tauri app (tauri://localhost,
# https://tauri.localhost). Add your own if you host a web build.
# CORS_ALLOWED_ORIGINS=http://localhost:1420,tauri://localhost,https://tauri.localhost

# Set to true only when running behind a reverse proxy, so rate limits use the
# client address the proxy reports (X-Forwarded-For) instead of the proxy's.
# TRUST_PROXY=true
